#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define HOST_OS 1

#include "zmk-helpers/helper.h"
#include "zmk-helpers/unicode-chars/currency.dtsi"
#include "zmk-helpers/unicode-chars/german.dtsi"

#include "behaviors/version.dtsi"
#include "key-labels/adv360.h"

#define XXX &none
#define ___ &trans

// layers
#define LAY_BASE 0
#define LAY_NHM  1
#define LAY_FN   2
#define LAY_KP   3
#define LAY_MM   4
#define LAY_SYS  5

// key-labels
#define KEYS_LN LN0 LN1 LN2 LN3 LN4 LN5 LN6
#define KEYS_LT LT0 LT1 LT2 LT3 LT4 LT5 LT6
#define KEYS_LM LM0 LM1 LM2 LM3 LM4 LM5 LM6
#define KEYS_LB     LB1 LB2 LB3 LB4 LB5 LB6
#define KEYS_LF         LF2 LF3 LF4 LF5 LF6
#define KEYS_LH LH0 LH1 LH2 LH3 LH4 LH5

#define KEYS_RN RN0 RN1 RN2 RN3 RN4 RN5 RN6
#define KEYS_RT RT0 RT1 RT2 RT3 RT4 RT5 RT6
#define KEYS_RM RM0 RM1 RM2 RM3 RM4 RM5 RM6
#define KEYS_RB     RB1 RB2 RB3 RB4 RB5 RB6
#define KEYS_RF         RF2 RF3 RF4 RF5 RF6
#define KEYS_RH RH0 RH1 RH2 RH3 RH4 RH5

#define KEYS_L  KEYS_LN KEYS_LT KEYS_LM KEYS_LB KEYS_LF
#define KEYS_R  KEYS_RN KEYS_RT KEYS_RM KEYS_RB KEYS_RF
#define THUMBS  KEYS_LH KEYS_RH

// home-row-mods
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

// combos
ZMK_COMBO(media_mute_1, &kp C_MUTE, RM2 RM3, LAY_MM) // j+k
ZMK_COMBO(media_mute_2, &kp C_MUTE, RF2 RF3, LAY_MM) // down+up
ZMK_COMBO(cut,          &kp LC(X),  LB4 LB2, LAY_BASE) // x+v
ZMK_COMBO(copy,         &kp LC(C),  LB4 LB3, LAY_BASE) // x+c
ZMK_COMBO(paste,        &kp LC(V),  LB3 LB2, LAY_BASE) // c+v

